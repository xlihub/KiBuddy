{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/xlihub/KiBuddy/distributions/schemas/manifest.schema.json",
  "title": "Ki-Buddy project distribution manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "distributionId",
    "version",
    "baseline",
    "brand",
    "identityMode",
    "integrations",
    "disabledFeatures",
    "nonSensitiveConfig",
    "resources",
    "platforms"
  ],
  "properties": {
    "schemaVersion": { "const": 2 },
    "distributionId": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "version": { "type": "string" },
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "commit"],
      "properties": {
        "repository": { "const": "xlihub/KiBuddy" },
        "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" }
      }
    },
    "brand": {
      "type": "object",
      "additionalProperties": false,
      "required": ["productName", "packageName", "description"],
      "properties": {
        "productName": { "const": "Ki-Buddy" },
        "packageName": { "type": "string" },
        "description": { "type": "string" }
      }
    },
    "identityMode": { "enum": ["local", "agents"] },
    "integrations": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "disabledFeatures": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "nonSensitiveConfig": { "type": "object" },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["png", "ico", "icns"],
      "properties": {
        "png": { "type": "string" },
        "ico": { "type": "string" },
        "icns": { "type": "string" }
      }
    },
    "platforms": {
      "type": "object",
      "additionalProperties": false,
      "required": ["preview", "formal"],
      "properties": {
        "preview": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "formal": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
      }
    }
  }
}
